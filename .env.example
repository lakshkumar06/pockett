# Copy to .env at the repository root. Never commit .env or paste keys into chat.
# Run the gateway and worker from Runtime/ using npm start / npm run worker.
HOST=127.0.0.1
PORT=8787
# Set POCKET_DOMAIN for Vultr HTTPS deployment (e.g. pocket.example.com).
POCKET_DOMAIN=
POCKET_PUBLIC_ORIGIN=http://127.0.0.1:8787
SPACETIME_URL=http://127.0.0.1:3000
SPACETIME_DATABASE=pockett-local
# Use the identity that first published this database. Local setup instructions in docs/SETUP.md.
SPACETIME_TOKEN=

# NVIDIA hosted Nemotron. Select a currently available tool-calling Nemotron model.
NVIDIA_API_KEY=
NEMOTRON_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Photon 2.0 project key, project ID, and provisioned agent sender ID.
# Empty = disabled. Polling uses the authenticated API, no public webhook needed.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SENDER_ID=

# Used only by cloud-deploy; never passed to generated apps.
VULTR_API_KEY=
