{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runtimeVersion": {
      "const": 1
    },
    "creatorKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "icon": {
          "enum": [
            "figure.walk",
            "figure.run",
            "bicycle",
            "map"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "name",
        "icon",
        "summary"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "enum": [
          "route.recording",
          "liveActivity.route"
        ]
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "metric"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "binding": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "source": {
                              "const": "route"
                            },
                            "field": {
                              "enum": [
                                "distanceMeters",
                                "elapsedSeconds",
                                "status"
                              ]
                            },
                            "type": {
                              "enum": [
                                "number",
                                "string"
                              ]
                            }
                          },
                          "required": [
                            "source",
                            "field",
                            "type"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "source": {
                              "const": "data"
                            },
                            "dataSource": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                            },
                            "field": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                            },
                            "type": {
                              "enum": [
                                "number",
                                "string",
                                "boolean"
                              ]
                            }
                          },
                          "required": [
                            "source",
                            "dataSource",
                            "field",
                            "type"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "binding"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "routeMap"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "button"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "action": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "route.start"
                            },
                            "activityType": {
                              "enum": [
                                "walk",
                                "run",
                                "cycle"
                              ]
                            }
                          },
                          "required": [
                            "type",
                            "activityType"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "route.stop"
                            }
                          },
                          "required": [
                            "type"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "liveActivity.start"
                            },
                            "layout": {
                              "const": "route-summary"
                            }
                          },
                          "required": [
                            "type",
                            "layout"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "liveActivity.stop"
                            }
                          },
                          "required": [
                            "type"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "navigate"
                            },
                            "screen": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                            }
                          },
                          "required": [
                            "type",
                            "screen"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "data.refresh"
                            },
                            "dataSource": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                            }
                          },
                          "required": [
                            "type",
                            "dataSource"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "action"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "components"
        ]
      }
    },
    "dataSources": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://[^\\s/?#@]+(?:/[^\\s?#]*)?$"
          },
          "method": {
            "const": "GET"
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "path": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                      }
                    },
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "path",
                    "type"
                  ]
                }
              }
            },
            "required": [
              "fields"
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 10000
          },
          "maxResponseBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        },
        "required": [
          "id",
          "url",
          "method",
          "response",
          "timeoutMs",
          "maxResponseBytes"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "creatorKey",
    "metadata",
    "capabilities",
    "screens"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pocket native experience v2"
}
